{
  "name": "loopmaatje",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // The id of the KV namespace "loopmaatje" (Storage & Databases > KV in the Cloudflare dashboard)
    { "binding": "LOOPMAATJE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
}
